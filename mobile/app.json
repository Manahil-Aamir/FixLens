{
  "expo": {
    "name": "FixLens",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "fixlens",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111827",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixlens.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "FixLens uses speech recognition to turn your voice into text.",
        "NSMicrophoneUsageDescription": "FixLens uses the microphone so you can describe the problem by voice."
      }
    },
    "android": {
      "package": "com.fixlens.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "FixLens uses the microphone so you can describe the problem by voice.",
          "speechRecognitionPermission": "FixLens uses speech recognition to turn your voice into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FixLens uses the camera to photograph or film the appliance."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d60ba8af-06dc-45ed-8fd0-491eb4042356"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d60ba8af-06dc-45ed-8fd0-491eb4042356"
    }
  }
}
